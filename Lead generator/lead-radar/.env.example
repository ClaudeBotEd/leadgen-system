# Lead Radar — environment variables
# Kopieer naar `.env` en vul in (`.env` staat in .gitignore).
# OF zet ze permanent in ~/.zshrc / ~/.bashrc.
#
# Geen enkele key is verplicht — pipeline draait door met fallbacks
# (regex-only scoring, geen Telegram alerts, geen Sentry).

# ─── Google Sheets sync ─────────────────────────────────────────────────
# Open je Google Sheet, kopieer ID uit URL (deel tussen /d/ en /edit).
# Share spreadsheet als Editor met het service-account email uit het JSON.
LEAD_RADAR_SPREADSHEET_ID=
LEAD_RADAR_GS_CREDENTIALS=lead-radar/.credentials/google_sheets.json

# ─── LLM-verifier (Claude Haiku) ────────────────────────────────────────
# Krijg key op https://console.anthropic.com/settings/keys
# Borderline scores (40-75) krijgen second-opinion — recall +20-30%.
# Kost ~€0.001/post. Skip met --no-llm op CLI.
ANTHROPIC_API_KEY=

# ─── Telegram hot-lead alerts ───────────────────────────────────────────
# 1. Op Telegram: open @BotFather → /newbot → krijg token
# 2. Start chat met je nieuwe bot, stuur willekeurig bericht
# 3. Open https://api.telegram.org/bot<token>/getUpdates
#    → kopieer chat.id uit response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ─── Error monitoring (optioneel) ───────────────────────────────────────
# https://sentry.io/settings/projects/<project>/keys/ → DSN copy
SENTRY_DSN=
LEAD_RADAR_ENV=dev

# ─── Logging ────────────────────────────────────────────────────────────
# json = structured logging (production/Grafana/Loki)
# leeg = mensvriendelijke text-format (development)
LEAD_RADAR_LOG_FORMAT=

# ─── Reddit OAuth (toekomstig — verhoogt rate-limit 60→600/min) ─────────
# Maak een script-app op https://www.reddit.com/prefs/apps
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=lead-radar/0.2 by /u/yourusername
