# =============================================================================
# LLM Council — environment template
# Copy to .env.local and fill in real values. Never commit .env.local.
# =============================================================================

# --- Required ---------------------------------------------------------------
# OpenRouter API key — https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# --- Server -----------------------------------------------------------------
LLM_COUNCIL_HOST=0.0.0.0
LLM_COUNCIL_PORT=8001
LLM_COUNCIL_LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
LLM_COUNCIL_ENV=development         # development | production

# --- CORS -------------------------------------------------------------------
# Allowed origins for browser clients. Accepts any of:
#   - single value:  LLM_COUNCIL_CORS_ORIGINS=http://localhost:5173
#   - CSV:           LLM_COUNCIL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
#   - JSON array:    LLM_COUNCIL_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
LLM_COUNCIL_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Storage ----------------------------------------------------------------
# SQLite URL (default). Switch to postgresql+asyncpg://... for Postgres later.
LLM_COUNCIL_DATABASE_URL=sqlite+aiosqlite:///./data/llm_council.db

# --- Models -----------------------------------------------------------------
# Comma-separated council members + a single chairman.
# Balanced cost defaults: gpt-4.1-mini + gemini-2.5-flash + claude-3.5-haiku.
LLM_COUNCIL_MODELS=openai/gpt-4.1-mini,google/gemini-2.5-flash,anthropic/claude-3.5-haiku
LLM_COUNCIL_CHAIRMAN_MODEL=openai/gpt-4.1
LLM_COUNCIL_TITLE_MODEL=google/gemini-2.5-flash

# --- HTTP / API -------------------------------------------------------------
LLM_COUNCIL_REQUEST_TIMEOUT_SECONDS=120
LLM_COUNCIL_RATE_LIMIT_PER_MINUTE=60

# --- Integrations -----------------------------------------------------------
# Optional bearer token consumers (n8n, CRM, outreach) must supply via
# Authorization: Bearer <token>. Leave empty in development to disable auth.
LLM_COUNCIL_API_TOKEN=
